<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parola Oluşturucu" Width="720" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#F5F8FD" FontFamily="Segoe UI" Foreground="#14243A" FontSize="15">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#123458"/>
      <Setter Property="BorderBrush" Value="#CDDAEB"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="19" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".78"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".62"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,0,18,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="28,23,28,24">
    <TextBlock Text="Parola Oluşturucu" FontSize="29" FontWeight="SemiBold"/>
    <TextBlock Text="Parolalar bu cihazda oluşturulur ve kaydedilmez." Foreground="#526780" Margin="0,3,0,18"/>
    <Border Background="White" BorderBrush="#DDE7F4" BorderThickness="1" CornerRadius="20" Padding="20">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <Button x:Name="Copy" DockPanel.Dock="Right" Width="112" Margin="12,0,0,0"
                  Background="#006FF2" BorderBrush="#006FF2" Foreground="White" FontWeight="Bold" Content="Kopyala"/>
          <Border Background="#F6F9FE" BorderBrush="#CDDAEB" BorderThickness="1" CornerRadius="22" Padding="13,4,5,4">
            <DockPanel Height="35">
              <Button x:Name="Refresh" DockPanel.Dock="Right" Content="↻" Width="36" Padding="0"
                      FontSize="20" ToolTip="Yeni parola oluştur" AutomationProperties.Name="Yeni parola oluştur"/>
              <Border x:Name="Badge" DockPanel.Dock="Right" Background="#DCF5C1" CornerRadius="8"
                      Padding="8,3" Margin="8,0" VerticalAlignment="Center">
                <TextBlock x:Name="Strength" FontSize="12" FontWeight="SemiBold"/>
              </Border>
              <TextBox x:Name="Password" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                       VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="17"
                       AutomationProperties.Name="Oluşturulan parola"/>
            </DockPanel>
          </Border>
        </DockPanel>
        <DockPanel Margin="0,24,0,0" Height="38">
          <TextBlock x:Name="Length" DockPanel.Dock="Left" Width="167" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <Button x:Name="Increase" DockPanel.Dock="Right" Width="38" Content="+" FontSize="21" Padding="0" AutomationProperties.Name="Uzunluğu artır"/>
          <Button x:Name="Decrease" DockPanel.Dock="Left" Width="38" Content="−" FontSize="21" Padding="0" AutomationProperties.Name="Uzunluğu azalt"/>
          <Slider x:Name="LengthSlider" Minimum="4" Maximum="64" Value="16" TickFrequency="1"
                  IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="12,0" AutomationProperties.Name="Parola uzunluğu"/>
        </DockPanel>
        <DockPanel Margin="0,23,0,0">
          <TextBlock Text="Karakter türleri" Width="167" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="Upper" Content="ABC" IsChecked="True" AutomationProperties.Name="Büyük harfler"/>
            <CheckBox x:Name="Lower" Content="abc" IsChecked="True" AutomationProperties.Name="Küçük harfler"/>
            <CheckBox x:Name="Digits" Content="123" IsChecked="True" AutomationProperties.Name="Rakamlar"/>
            <CheckBox x:Name="Symbols" Content="#$&amp;" AutomationProperties.Name="Semboller"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
    <TextBlock x:Name="Status" Foreground="#526780" Margin="3,10,0,0" Height="22"/>
  </StackPanel>
</Window>
